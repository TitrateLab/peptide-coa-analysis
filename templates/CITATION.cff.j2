abstract: >-
  Monthly, vendor-blind aggregates of {{ included | comma }} published peptide lab reports
  ({{ cov.included_compounds }} compounds, {{ m.lab_dimension.published_labs }} named laboratories,
  {{ months[0].month }} to {{ last_full }}) by compound, laboratory and month, with purity,
